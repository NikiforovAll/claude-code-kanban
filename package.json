{
  "name": "claude-code-kanban",
  "version": "4.27.0",
  "description": "A web-based Kanban board for viewing Claude Code tasks with agent teams support",
  "main": "server.js",
  "bin": {
    "claude-code-kanban": "server.js"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test test/*.test.js",
    "test:hooks": "bash tests/test-agent-spy.sh && bash tests/test-approval-gate.sh",
    "validate:schemas": "node test/validate-live-schemas.js",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NikiforovAll/claude-code-kanban.git"
  },
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "tasks",
    "todo",
    "kanban",
    "viewer",
    "agent-teams"
  ],
  "author": "NikiforovAll",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/NikiforovAll/claude-code-kanban/issues"
  },
  "homepage": "https://github.com/NikiforovAll/claude-code-kanban#readme",
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "chokidar": "^3.5.3",
    "express": "^4.18.2",
    "open": "^11.0.0",
    "ws": "8.21.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "server.js",
    "cli.js",
    "install.js",
    "plugin/**/*",
    "lib/**/*",
    "public/**/*"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "husky": "^9.1.7"
  },
  "optionalDependencies": {
    "@lydell/node-pty": "1.2.0-beta.15"
  }
}
