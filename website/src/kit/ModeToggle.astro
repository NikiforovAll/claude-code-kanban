<mode-toggle>
  <button type="button" class="mode" aria-label="Dark mode" aria-pressed="false">
    <svg class="sun" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
    </svg>
    <svg class="moon" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
    </svg>
  </button>
</mode-toggle>

<script>
  class ModeToggle extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector('button')!;
      button.addEventListener('click', () => {
        window.siteTheme.set(null, window.siteTheme.mode === 'dark' ? 'light' : 'dark');
      });
      const sync = () => button.setAttribute('aria-pressed', String(window.siteTheme.mode === 'dark'));
      document.addEventListener('site-theme', sync);
      sync();
    }
  }
  customElements.define('mode-toggle', ModeToggle);
</script>

<style>
  mode-toggle {
    display: inline-flex;
  }
  .mode {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    color: var(--c-ink2);
    background: transparent;
    border: 1px solid var(--c-border);
    border-radius: 50%;
    cursor: pointer;
  }
  .mode:hover {
    color: var(--c-ink1);
    background: var(--c-hover);
  }
  .mode:focus-visible {
    outline: 2px solid var(--c-accent);
    outline-offset: 2px;
  }
  svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .moon {
    display: none;
  }
  :global([data-theme='dark']) .sun {
    display: none;
  }
  :global([data-theme='dark']) .moon {
    display: block;
  }
</style>
