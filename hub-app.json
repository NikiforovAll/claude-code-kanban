{
  "manifest": 1,
  "id": "kanban",
  "name": "Kanban",
  "icon": "columns",
  "run": { "entry": "server.js", "defaultPort": 3541 },
  "publishes": ["session.changed"],
  "keys": { "keeps": ["ctrl+alt+n", "ctrl+alt+r", "ctrl+alt+s"] },
  "provides": {
    "projects": { "path": "/api/projects" },
    "terminal": { "liveWork": "/api/terminals" }
  },
  "loading": {
    "verbs": [
      "Shuffling cards…",
      "Herding tasks…",
      "Waking sessions…",
      "Sorting the board…",
      "Pinning sticky notes…",
      "Moving cards to done…",
      "Nudging agents…",
      "Drawing columns…",
      "Reading the backlog…"
    ]
  }
}
