{
  "manifest": 1,
  "id": "swarm",
  "name": "Swarm",
  "icon": "network",
  "run": { "entry": "server.js", "defaultPort": 3546 },
  "loading": {
    "verbs": ["Reading the board…", "Replaying the log…", "Counting claims…", "Following the workers…"]
  },
  "actions": {
    "handles": {
      "swarm.open": { "params": { "swarm": "string?" }, "url": "?swarm={swarm}", "mode": "message" }
    }
  }
}
